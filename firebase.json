{
  "hosting": [
    {
      "public": ".",
      "ignore": [
        "firebase.json",
        ".firebaserc",
        "CNAME",
        "README.md",
        ".github/**",
        "**/.*",
        "**/node_modules/**",
        "desk-site/**",
        "tests/**",
        "firestore.rules"
      ],
      "cleanUrls": true,
      "headers": [
        {
          "source": "**/*.html",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "**",
          "headers": [
            {
              "key": "X-Content-Type-Options",
              "value": "nosniff"
            }
          ]
        }
      ],
      "target": "website"
    },
    {
      "target": "desk",
      "public": "desk-site",
      "ignore": [
        "**/.*",
        "**/node_modules/**"
      ],
      "cleanUrls": false,
      "headers": [
        {
          "source": "**/*.html",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "**",
          "headers": [
            {
              "key": "X-Content-Type-Options",
              "value": "nosniff"
            }
          ]
        },
        {
          "regex": "^/[a-z0-9-]+/.*$",
          "headers": [
            {
              "key": "X-Robots-Tag",
              "value": "noindex, nofollow"
            }
          ]
        },
        {
          "source": "/quote/**",
          "headers": [
            {
              "key": "X-Robots-Tag",
              "value": "noindex, nofollow"
            }
          ]
        }
      ],
      "rewrites": [
        {
          "regex": "^/[a-z0-9-]+/quote(/.*)?$",
          "destination": "/quote/index.html"
        },
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules"
  }
}
