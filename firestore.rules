rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Two ways in: an account the owner or a team manager created (matched by its account id; it has a username and an
    // email address that stays with the profile), or an older team entry matched by a confirmed email address.
    function authed() { return request.auth != null; }
    function signedIn() { return authed() && request.auth.token.email_verified == true; }
    function myEmail() { return request.auth.token.email.lower(); }
    function me() { return request.auth.uid; }
    // a person may only tick off their own first-sign-in setup; their username, email and role stay as they were made
    function selfUpdate() { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['mustChange', 'lastSeen']) && request.resource.data.get('mustChange', false) == false; }

    // ── NOVYRA (novyradesk.com) ─────────────────────────────────────────────
    // Novyra's own records sit at the top level. Only Novyra's owners and team can use them.
    function isOwner() { return signedIn() && myEmail() in ['hanu@keysers.cc', 'hanukeyser@gmail.com']; }
    function userDoc() { return /databases/$(database)/documents/users/$(me()); }
    function member() { return authed() && exists(userDoc()) && get(userDoc()).data.active == true; }
    function editor() { return member() && get(userDoc()).data.role in ['admin', 'staff']; }

    // Owner: all of Novyra's records (never other companies' records, see below)
    match /{col}/{document=**} { allow read, write: if isOwner() && col != 'companies'; }

    // Novyra's team: accounts the owner created. Viewers read, admins and staff also write. Only the owner changes the team.
    match /{col}/{document=**} {
      allow read: if member() && !(col in ['users', 'companies', 'usernames', 'brands']);
      allow write: if editor() && !(col in ['users', 'companies', 'usernames', 'brands']);
    }
    // Usernames: the sign-in page looks one up to find the email it signs in with. One name at a time, never a list.
    // Each desk (novyra, or a company's address) has its own usernames; whoever manages that desk's team claims them.
    match /usernames/{desk}/names/{name} {
      allow get: if true;
      allow create: if (isOwner() || coManager(desk)) && name.matches('^[a-z0-9][a-z0-9._-]{2,29}$')
        && request.resource.data.keys().hasOnly(['email', 'uid']) && request.resource.data.email is string && request.resource.data.uid is string;
      allow delete: if (desk == 'novyra' && isOwner()) || coManager(desk);
    }

    // Brand cards: a company's name and logo, shown on its sign-in page before anyone signs in. One at a time, never a list.
    // The company's owner or admins keep it up to date; Novyra's owner writes the first one when setting the company up.
    match /brands/{c} {
      allow get: if true;
      allow create, update: if (isOwner() || coManager(c))
        && request.resource.data.keys().hasOnly(['name', 'logo', 'updatedAt'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100
        && request.resource.data.get('logo', '') is string && request.resource.data.get('logo', '').size() < 400000;
    }

    match /users/{u} {
      allow read: if member() || (authed() && u == me());
      allow update: if authed() && u == me() && selfUpdate();
    }

    // Novyra's customer links: anyone with the link can open a quote, invoice or receipt; only quotes can be accepted, declined or changed
    match /shares/{key} {
      allow get: if true;
      allow update: if customerAnswer();
    }

    // ── OTHER COMPANIES (novyradesk.com/<company>/) ─────────────────────────
    // Each company's records live only under companies/<company>/. Only that company's owners and team can use them.
    function company(c) { return /databases/$(database)/documents/companies/$(c); }
    function teamDoc(c) { return /databases/$(database)/documents/companies/$(c)/users/$(me()); }
    function oldTeamDoc(c) { return /databases/$(database)/documents/companies/$(c)/users/$(myEmail()); }
    function coOwner(c) { return authed() && exists(company(c)) && (me() in get(company(c)).data.get('ownerUids', [])
      || (signedIn() && myEmail() in get(company(c)).data.get('owners', []))); }
    function coTeam(c) { return authed() && exists(teamDoc(c)) && get(teamDoc(c)).data.active == true; }
    function coOldTeam(c) { return signedIn() && exists(oldTeamDoc(c)) && get(oldTeamDoc(c)).data.active == true; }
    function coRole(c, roles) { return (coTeam(c) && get(teamDoc(c)).data.role in roles) || (coOldTeam(c) && get(oldTeamDoc(c)).data.role in roles); }
    function coMember(c) { return coOwner(c) || coTeam(c) || coOldTeam(c); }
    function coEditor(c) { return coOwner(c) || coRole(c, ['owner', 'admin', 'staff']); }
    function coManager(c) { return coOwner(c) || coRole(c, ['owner', 'admin']); }
    function hasOwner(d) { return (d.get('owners', []) is list && d.get('owners', []).size() > 0) || (d.get('ownerUids', []) is list && d.get('ownerUids', []).size() > 0); }

    match /companies/{c} {
      // Novyra's owner sets a company up (name, address, the owner's account) and can see the list of companies, nothing inside them
      allow get: if coMember(c) || isOwner();
      allow list: if isOwner();
      allow create: if isOwner()
        && c.matches('^[a-z0-9][a-z0-9-]{1,38}[a-z0-9]$')
        && request.resource.data.name is string && request.resource.data.name.size() > 0
        && hasOwner(request.resource.data);
      // the company's own owners can rename it or change its owners
      allow update: if coOwner(c) && hasOwner(request.resource.data);

      // the company's team list: everyone on the team can see it, only owners and admins change it
      match /users/{u} {
        allow read: if coMember(c) || (authed() && u == me()) || (signedIn() && myEmail() == u);
        allow write: if coManager(c);
        allow update: if authed() && u == me() && selfUpdate();
      }

      // the company's customer links: anyone with the link can open one; customers can only answer a quote
      match /shares/{key} {
        allow get: if true;
        allow list: if coMember(c);
        allow create, delete: if coEditor(c);
        allow update: if coEditor(c) || customerAnswer();
      }

      // everything else the company keeps: customers, quotes, invoices, settings, calendar, expenses…
      match /{col}/{document=**} {
        allow read: if coMember(c) && col != 'shares';
        allow write: if coEditor(c) && col != 'users' && col != 'shares';
      }
    }

    // A customer answering a quote: only an open, unexpired quote; only the answer can change
    function customerAnswer() {
      return resource.data.get('kind', 'quote') == 'quote'
        && resource.data.status == 'Open' && request.time < resource.data.validTs
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'response'])
        && request.resource.data.status in ['Accepted', 'Changes requested', 'Declined']
        && request.resource.data.response.keys().hasOnly(['name', 'note', 'at', 'rev'])
        && request.resource.data.response.name is string && request.resource.data.response.name.size() >= 2 && request.resource.data.response.name.size() <= 99
        && request.resource.data.response.note is string && request.resource.data.response.note.size() < 2000
        && request.resource.data.response.rev == resource.data.rev;
    }
  }
}
