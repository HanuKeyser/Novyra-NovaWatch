rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Personal library (unchanged) ----
    // Every user's own document and subcollections (library, archivedShows)
    // stay private to that user, exactly as before.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ---- Shared households ----
    match /households/{householdId} {
      allow create: if request.auth != null
                    && request.resource.data.memberIds == [request.auth.uid]
                    && request.resource.data.createdBy == request.auth.uid;

      allow read: if request.auth != null
                  && request.auth.uid in resource.data.memberIds;

      // Two distinct kinds of update are allowed:
      //  1) an existing member editing anything (name, member list, etc) -
      //     matches the "everyone has full edit rights" model.
      //  2) a NON-member joining via a valid invite link, who may only add
      //     their own uid to memberIds and nothing else. The invite token
      //     itself (long, random, privately shared) is the real security
      //     boundary here, same as an "anyone with the link" share link -
      //     there's no backend function to cross-check the token against
      //     this specific write, so the rule instead just guarantees a
      //     joining request can ONLY append the requester's own uid and
      //     cannot rewrite anything else about the household.
      allow update: if request.auth != null && (
        request.auth.uid in resource.data.memberIds
        ||
        (
          !(request.auth.uid in resource.data.memberIds) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds']) &&
          request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1 &&
          request.resource.data.memberIds.hasAll(resource.data.memberIds) &&
          request.auth.uid in request.resource.data.memberIds
        )
      );

      allow delete: if request.auth != null && request.auth.uid == resource.data.createdBy;

      match /library/{itemId} {
        allow read, write: if request.auth != null
                            && request.auth.uid in get(/databases/$(database)/documents/households/$(householdId)).data.memberIds;
      }
    }

    // ---- One-time invite links ----
    match /invites/{token} {
      allow create: if request.auth != null
                    && request.resource.data.createdBy == request.auth.uid
                    && request.resource.data.used == false
                    && request.auth.uid in get(/databases/$(database)/documents/households/$(request.resource.data.householdId)).data.memberIds;

      // Anyone signed in can read an invite doc to check it's valid before
      // joining - the token in the URL is what makes this safe, same as
      // any "anyone with this link" share.
      allow read: if request.auth != null;

      // Claiming an invite: only allowed while unused, and the claim must
      // only set used/usedBy/usedAt - nothing else about the invite.
      allow update: if request.auth != null
                    && resource.data.used == false
                    && request.resource.data.used == true
                    && request.resource.data.usedBy == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['used', 'usedBy', 'usedAt']);

      allow delete: if request.auth != null && request.auth.uid == resource.data.createdBy;
    }
  }
}
